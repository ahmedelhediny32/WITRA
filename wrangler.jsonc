{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "witra-marketing",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "dist/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "witra-marketing-production",
      "database_id": "b2b6c359-dfa6-4cc6-a6ab-d8e4141710ef"
    }
  ]
}