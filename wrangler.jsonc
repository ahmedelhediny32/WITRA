{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "witra-marketing",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "witra-marketing-production",
      "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID"
    }
  ],
  "main": "dist/_worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}